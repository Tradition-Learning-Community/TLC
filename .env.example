# Local PostgreSQL with Laragon (see README.md). Replace both local credentials.
DATABASE_URL=postgresql://tlc_dev:your_local_password@127.0.0.1:5433/tlc_dev

# Admin login for local development only.
ADMIN_PASSWORD=choose-a-local-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Optional: separate signing secret for member sessions; if absent, the admin session secret is used.
MEMBER_SESSION_SECRET=generate-a-different-long-random-secret
