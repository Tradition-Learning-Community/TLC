# TLC - configuration du serveur Next.js (sans secrets dans Git)
# Copier vers .env.local en développement ou vers les variables chiffrées de l'hébergeur.
# Le code fonctionne hors Vercel avec PostgreSQL et un stockage S3 compatible.

# PostgreSQL persistant. Utiliser une connexion poolée Neon ou un PostgreSQL accessible par le serveur.
DATABASE_URL=

# Sessions et compte administrateur principal (ADMIN_SESSION_SECRET obligatoire).
ADMIN_SESSION_SECRET=

# Ancien accès partagé : uniquement pour migration ; désactiver dans Administration TLC.
# Ne pas remplir si vous n'utilisez pas l'ancien accès.
ADMIN_PASSWORD=
TLC_LEGACY_RECOVERY_ENABLED=false

# Comptes nominatifs de l'équipe - Neon Auth.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Fournisseur de médias : s3 (portable, recommandé) ou vercel-blob (tests Vercel possibles).
MEDIA_STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# Seulement avec MEDIA_STORAGE_DRIVER=vercel-blob :
BLOB_READ_WRITE_TOKEN=

# Notifications par e-mail facultatives (les alertes internes n'en dépendent pas).
RESEND_API_KEY=
TLC_ALERT_FROM=
TLC_ALERT_TO=
